#!/usr/bin/env python3
"""tv-mood - calm Hue ambience from the Samsung TV picture (2026-10-18, Pi caretaker).

The TV app HyperTizen (a patched build; the patches are not in this public copy) samples a 5x4 grid of single pixels over the picture, ~5 times
a second, and sends them as a 64x48 PNG with one block per point. Single pixels flicker with every
detail, so this sits between the TV and HyperHDR and turns them into a steady room mood:
  1. per cell: median of its last 4 readings = its 4 shifted spots. The patched TV app
     reads 8 of 80 spots per frame, ~10 frames/s, so each cell gets a new reading ~4 times/s and
     a still picture gives the same value every time (no wobble)
  2. colour science (rebuilt 2026-10-19 after "dark, washed out, inaccurate, wrong spots"):
     samples go to linear light first; HDR / Dolby Vision (reported by the media server,
     optional) is decoded from PQ and BT.2020 to SDR BT.709, otherwise sRGB. Each lamp takes ITS OWN part of
     the picture (only 15 % of the whole scene mixed in), weighted so vivid and bright samples
     lead and black bars do not; colour strength is lifted the way Hue needs (pale -> rich);
     brightness follows that part of the picture, so the bright side of the screen lights its
     side of the room. Near-black keeps a soft glow in the scene's own colour.
  3. colour follows in ~0.45 s; brightness always glides (~1.2 s, capped at 35 %/s), so lamps fade
     up and down instead of jumping; HyperHDR adds one short 150 ms blend between frames
Picture mode (from HA): Standard full brightness, Movie 80 %, FILMMAKER MODE 60 %.
The sync runs ONLY when the owner asked for it (2026-10-21: "I have a shortcut for that"):
Home Assistant's script.hue_sync calls GET /sync/true ("Sync lights") or /sync/false (every
lighting routine and "Stop syncing") on :8098. Off = nothing is sent to HyperHDR at all, so
turning the TV on cannot start it. On = frames flow; the director hands the lamps back (HyperHDR
output off) when no screen feeds it for 10 s and takes them again when one does.
Output: a 9x4 RGB image (HyperHDR ignores 1-pixel-tall ones) to HyperHDR (127.0.0.1:19444, priority 90), one pixel per lamp in
the Hue area "PC Gaming" channel order; HyperHDR streams it to the bridge.
The TV app is pointed here with rpcServer = ws://192.168.1.10:8095/ (docs/tv-ambient-lighting.md).
"""
import base64, collections, colorsys, io, json, math, os, socket, struct, threading, time
from PIL import Image

LISTEN = ("0.0.0.0", 8095)
HYPERHDR = ("127.0.0.1", 19444)
PRIORITY, FPS = 90, 25
HISTORY = 12                          # readings kept per cell (the TV reads 8 of 80 spots per frame)
TAU_CALM, TAU_CUT = 0.45, 0.15        # seconds: colour following vs a hard scene cut, see main()
TAU_LEVEL, LEVEL_RATE = 1.2, 0.35     # brightness: ~1.2 s glide, at most 35 % of full range per second
CUT_GLOBAL, CUT_LAMP = 90, 999        # only a hard cut of the whole picture speeds up (no per-lamp switching)
SPOTS = 4                             # shifted spots the TV reads per cell, in turn (patched TV app)
GLOBAL = 0.3                          # share of the whole scene in every lamp (rest = its own part)
MIN_GLOW = 0.18                       # softest glow allowed (0-1 lamp level): dark scenes keep a glow
# TV picture mode -> how bright the room glows (HA tells us: input_select.tv_picture_mode)
MODE_GAIN = {"Standard": 1.0, "Movie": 0.8, "FILMMAKER MODE": 0.6}
MODE_FILE = "/var/lib/tv-mood/picture-mode"
MODE_PORT = ("127.0.0.1", 8098)       # GET /mode/<name> from Home Assistant (same host only)
VALUE_GAIN = 1.6                      # lamp level = picture level x this (then capped by the mode)
SAT_GAIN = 1.15                       # gentle colour strength lift (natural, not neon)
NEUTRAL = (1.0, 0.78, 0.55)           # colourless parts glow warm white, never cold blue-white

# HyperTizen (Pi build, 2026-10-18) samples a 5 x 4 grid over the whole picture and draws one
# block per point in its 64x48 frame, row by row. Zone "c,r" = column c (0 left), row r (0 top).
COLS, ROWS = 5, 4
ZONES = {(c, r): (int((c + 0.5) * 64 / COLS), int((r + 0.5) * 48 / ROWS)) for r in range(ROWS) for c in range(COLS)}
def _z(cols, rows): return [(c, r) for c in cols for r in rows]
# Hue channel order of the area and the part of the picture each lamp follows, seen from the sofa
# facing the TV (owner's own floor plan, 2026-10-19; the lamp test confirmed every channel): desk
# with both Play bars and the strip on the left wall, floor lantern just left of the TV, corner
# shelves right of the TV (Cozy on the 2nd shelf nearest the TV, Mushroom 3rd, Retro top), the
# sphere on the right wall by the bed, the uplighter behind the sofa (whole picture).
LAMPS = [_z([0], [0, 1, 2]),          # Left Lightbar   (desk, left wall)
         _z([0], [1, 2, 3]),          # Right Lightbar  (desk, left wall)
         _z([0, 1], [2, 3]),          # LED Strip       (desk, left wall, low)
         _z([0], [0, 1, 2]),          # Floor Lantern   (tall, just left of the TV)
         _z(range(COLS), range(ROWS)),  # Floor Uplighter (behind the sofa: the whole picture)
         _z([4], [0, 1]),             # Retro Lamp      (corner shelves, top)
         _z([3, 4], [2, 3]),          # Cozy Light      (corner shelves, 2nd, nearest the TV)
         _z([4], [1, 2]),             # Mushroom Lamp   (corner shelves, 3rd)
         _z([4], [2, 3])]             # Glowing Sphere  (right wall, by the bed)

hist = {z: collections.deque(maxlen=HISTORY) for z in ZONES}
lock = threading.Lock()
last_frame = 0.0
frame_no = 0                          # counts TV frames, so each one is sent exactly once
peer = "?"                            # address of the last HyperTizen connection (for the log)


def median(vals):
    s = sorted(vals); n = len(s)
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2


def robust_zones():
    # each cell = per-channel median of its last SPOTS readings. The TV reads each cell's SPOTS
    # shifted spots in turn (one full round ~1 s), so the last SPOTS readings are always the same
    # set of spots: a still picture gives exactly the same value every time, and a single
    # 16x16-pixel detail cannot swing it. (Until 2026-10-20 this took "readings from the last
    # 0.8 s", which is 3 readings one moment and 4 the next; the median of a bright/dark cell
    # then flips between the two every few frames: the lamps wobbled on a paused frame.)
    with lock:
        if not all(hist[z] for z in ZONES): return None
        out = {}
        for z in ZONES:
            recent = [c for t, c in list(hist[z])[-SPOTS:]]
            out[z] = tuple(median([c[i] for c in recent]) for i in range(3))
        return out


# --- colour science ---------------------------------------------------------------------------
def srgb_to_lin(v):
    return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4


def lin_to_srgb(v):
    v = max(0.0, v)
    return 12.92 * v if v <= 0.0031308 else 1.055 * v ** (1 / 2.4) - 0.055


PQ_M1, PQ_M2, PQ_C1, PQ_C2, PQ_C3 = 0.1593017578125, 78.84375, 0.8359375, 18.8515625, 18.6875
HDR_WHITE = 100.0                     # nits that count as full SDR white (graded diffuse white)
BT2020_TO_709 = ((1.6605, -0.5876, -0.0728), (-0.1246, 1.1329, -0.0083), (-0.0182, -0.1006, 1.1187))


def pq_to_lin(v):
    e = v ** (1 / PQ_M2)
    nits = 10000 * (max(e - PQ_C1, 0) / (PQ_C2 - PQ_C3 * e)) ** (1 / PQ_M1)
    x = nits / HDR_WHITE
    return x if x < 0.75 else 0.75 + (x - 0.75) / (1 + (x - 0.75) / 0.25)   # soft roll-off to 1.0


def to_linear(c):
    # one sample (0-255 RGB as the TV app read it) -> linear BT.709 light, 0..1
    if hdr_active():
        l = [pq_to_lin(v / 255) for v in c]
        return tuple(max(0.0, sum(m * x for m, x in zip(row, l))) for row in BT2020_TO_709)
    return tuple(srgb_to_lin(v / 255) for v in c)


def luma(l):
    return 0.2126 * l[0] + 0.7152 * l[1] + 0.0722 * l[2]


def region(lins):
    # colour of one part of the picture: average in linear light, weighted so vivid and bright
    # samples lead (a red lamp on screen beats the dark wall around it) and black bars drop out
    tot, acc = 0.0, [0.0, 0.0, 0.0]
    for l in lins:
        mx, mn = max(l), min(l)
        chroma = (mx - mn) / mx if mx > 1e-4 else 0.0
        w = (luma(l) + 0.002) ** 0.6 * (0.15 + chroma) ** 2
        tot += w; acc = [a + w * x for a, x in zip(acc, l)]
    lin = [a / tot for a in acc]
    # brightness of the part: the light in a scene comes from its bright parts, so half the
    # mean and half the brightest sample (a lit window in a dark room still lights the room)
    ys = [luma(l) for l in lins]
    return lin, 0.5 * sum(ys) / len(ys) + 0.5 * max(ys)


def lamp_colour(lin, level):
    # linear colour + picture level -> lamp RGB 0-255 (sRGB-coded, as HyperHDR sends it on)
    enc = [lin_to_srgb(x) for x in lin]
    h, sat, _ = colorsys.rgb_to_hsv(*enc)
    if sat < 0.08:                                         # colourless: warm white, not blue-white
        r, g, b = NEUTRAL
        h, sat, _ = colorsys.rgb_to_hsv(r, g, b)
    else:
        sat = sat * SAT_GAIN
    sat = min(sat, 0.88)                                   # a hint of white keeps Hue colours natural
    v = max(MIN_GLOW, min(1.0, lin_to_srgb(level) * VALUE_GAIN)) * mode_gain()
    return tuple(x * 255 for x in colorsys.hsv_to_rgb(h, sat, v))


def mean(cols):
    return tuple(sum(c[i] for c in cols) / len(cols) for i in range(3))


def on_image(png_b64):
    global last_frame
    img = Image.open(io.BytesIO(base64.b64decode(png_b64))).convert("RGBA")
    if img.size != (64, 48): img = img.resize((64, 48))
    now = time.time()
    with lock:
        for z, xy in ZONES.items():
            r, g, b, a = img.getpixel(xy)
            if a: hist[z].append((now, (r, g, b)))          # transparent = cell not read this frame
        last_frame = time.time()
        global frame_no
        frame_no += 1
    if os.environ.get("TV_MOOD_DEBUG"):           # debugging only: what the TV actually sent
        read = sum(1 for xy in ZONES.values() if img.getpixel(xy)[3])
        print("frame", frame_no, "cells read", read, flush=True)
        try: img.save("/dev/shm/tv-mood-frame-%d.png" % (frame_no % 4))
        except OSError: pass


# --- tiny WebSocket server (HyperTizen sends JSON "image" commands as text frames) -------
def ws_client(conn):
    conn.settimeout(30)
    req = b""
    while b"\r\n\r\n" not in req:
        chunk = conn.recv(4096)
        if not chunk: return
        req += chunk
    key = [l.split(b":", 1)[1].strip() for l in req.split(b"\r\n") if l.lower().startswith(b"sec-websocket-key")]
    if not key: conn.close(); return
    import hashlib
    acc = base64.b64encode(hashlib.sha1(key[0] + b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11").digest())
    conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                 b"Sec-WebSocket-Accept: " + acc + b"\r\n\r\n")
    f = conn.makefile("rb")
    buf = b""
    while True:
        h = f.read(2)
        if len(h) < 2: return
        op, n = h[0] & 0x0F, h[1] & 0x7F
        if n == 126: n = struct.unpack(">H", f.read(2))[0]
        elif n == 127: n = struct.unpack(">Q", f.read(8))[0]
        mask = f.read(4) if h[1] & 0x80 else b"\0\0\0\0"
        data = bytes(b ^ mask[i % 4] for i, b in enumerate(f.read(n)))
        if op == 8: return
        if op == 9: conn.sendall(b"\x8a\x00"); continue
        buf += data
        if not h[0] & 0x80: continue
        msg, buf = buf, b""
        try:
            m = json.loads(msg)
            if m.get("command") == "image" and m.get("imagedata"): on_image(m["imagedata"])
        except Exception:
            pass


def server():
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(LISTEN); s.listen(4)
    global peer
    while True:
        c, addr = s.accept()
        peer = addr[0]
        threading.Thread(target=lambda: (ws_client(c), c.close()), daemon=True).start()


# --- picture mode: FILMMAKER dimmest, Movie middle, Standard brightest ----------------------
def mode_gain():
    try: return MODE_GAIN.get(open(MODE_FILE).read().strip(), 1.0)
    except OSError: return 1.0


def mode_server():
    from urllib.parse import unquote
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(MODE_PORT); s.listen(4)
    while True:
        c, _ = s.accept()
        try:
            line = c.recv(1024).split(b"\r\n")[0].decode(errors="replace")   # GET /mode/Movie HTTP/1.1
            parts = line.split(" ")
            path = parts[1] if len(parts) > 1 else ""
            if path.startswith("/app/") or path.startswith("/title/"):
                k = "name" if path.startswith("/app/") else "title"
                _app[k] = unquote(path.split("/", 2)[2])[:200]
                if _app[k] == "none": _app[k] = ""
                try:                                   # kept, so a restart still knows what is on screen
                    with open(APP_FILE, "w") as f: json.dump(_app, f)
                except OSError: pass
                c.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"); continue
            if path in ("/sync/true", "/sync/false"):
                want = path.endswith("true")
                set_wanted(want)
                ok = hyperhdr_leds(want)               # on: start now; off: let go of the lamps now
                print("sync", "on" if want else "off", "(owner)", "" if ok else "- HyperHDR not reached", flush=True)
                c.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok" if ok else
                          b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n"); continue
            mode = unquote(path[len("/mode/"):]) if path.startswith("/mode/") else ""
            if mode in MODE_GAIN:
                with open(MODE_FILE, "w") as f: f.write(mode)
                print("picture mode:", mode, flush=True)
                c.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
            else:
                c.sendall(b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
        except Exception: pass
        finally: c.close()


# --- HDR: is the TV showing an HDR / Dolby Vision stream? ------------------------------------
# The TV app reads PQ-coded HDR pixels as if they were ordinary ones: dark and grey. A
# Jellyfin-compatible media server knows the playing stream's video range (optional: set
# MEDIA_SERVER and hand the API key over with LoadCredential=media-token in the unit).
# Asked every 3 s; anything else (YouTube, Xbox, no answer) counts as SDR. The key comes from
# systemd's credential directory, never from a file this service could leak.
MEDIA_SERVER = os.environ.get("MEDIA_SERVER", "")
_hdr = {"on": False}
_app = {"name": "", "title": ""}      # what the Apple TV shows, pushed by Home Assistant (/app/, /title/)
APP_FILE = "/var/lib/tv-mood/on-screen.json"
try: _app.update(json.load(open(APP_FILE)))
except (OSError, ValueError): pass


# --- fire glow (owner, 2026-10-19) ---------------------------------------------------------------
# A fireplace video is a small fire in a black frame: following each lamp's own part of the
# picture leaves the room at its dimmest glow. Such a video is there to light the room, so the
# whole room takes the fire's colour and its brightness breathes with the flames. Lamps nearest the
# TV glow brightest and most golden, those further away a little dimmer and redder (light falling
# off across a room). Films and everything else keep the normal sync.
import re
GLOW_WORDS = re.compile(r"fire ?place|camp ?fire|bonfire|candle|yule log|fire sounds|burning logs", re.I)
GLOW_DEPTH = [0.8, 0.8, 0.72,         # desk: lightbars, strip (far left wall)
              1.0, 0.7,               # floor lantern (beside the TV), uplighter (back wall)
              0.95, 1.0, 0.95, 0.85]  # retro, cozy, mushroom (shelf by the TV), sphere (by the bed)
TAU_GLOW, GLOW_RATE = 0.6, 0.6        # flames breathe a bit faster than film brightness, still a glide


def glow_active():
    return bool(GLOW_WORDS.search(_app["title"] or ""))


def glow_targets(lin):
    fire = sorted(lin.values(), key=luma, reverse=True)[:5]          # the brightest quarter = the fire
    col, _ = region(fire)
    h, sat, _ = colorsys.rgb_to_hsv(*[lin_to_srgb(x) for x in col])
    sat = min(0.95, max(0.75, sat * 1.25))                          # rich flame colour, not neon
    glow = lin_to_srgb(sum(luma(z) for z in fire) / len(fire))     # how strongly it burns now
    lvl = 0.65 + 0.35 * min(1.0, glow / 0.35)
    out = []
    for d in GLOW_DEPTH:
        hh = (h - (1 - d) * 0.08) % 1.0                              # further lamps: a few degrees redder
        out.append(tuple(x * 255 for x in colorsys.hsv_to_rgb(hh, sat, lvl * d)))
    return out
TITLES_FILE = "/var/lib/tv-mood/hdr-titles.json"   # title -> HDR, learned when the server reports a stream


def hdr_active():
    return _hdr["on"]


def hdr_watch():
    # Some players report what plays only when playback starts (not after a pause), so every
    # title the server reports is remembered with its video range, and the title on screen (from
    # Home Assistant) decides. Anything unknown counts as SDR.
    import urllib.request
    if not MEDIA_SERVER: print("no MEDIA_SERVER: HDR detection off", flush=True); return
    try: key = open(os.path.join(os.environ.get("CREDENTIALS_DIRECTORY", "/nonexistent"), "media-token")).read().strip()
    except OSError: print("no media server key: HDR detection off", flush=True); return
    try: titles = json.load(open(TITLES_FILE))
    except (OSError, ValueError): titles = {}
    while True:
        try:
            req = urllib.request.Request(MEDIA_SERVER + "/Sessions", headers={"X-Emby-Token": key})
            with urllib.request.urlopen(req, timeout=4) as r:
                for sess in json.load(r):
                    it = sess.get("NowPlayingItem") or {}
                    vids = [ms for ms in it.get("MediaStreams") or [] if ms.get("Type") == "Video"]
                    if it.get("Name") and vids:
                        hdr = (vids[0].get("VideoRange") or "SDR").upper() != "SDR"
                        if titles.get(it["Name"]) != hdr:
                            titles[it["Name"]] = hdr
                            try:
                                with open(TITLES_FILE, "w") as f: json.dump(titles, f)
                            except OSError: pass
        except Exception:
            pass
        on = bool(titles.get(_app["title"])) if _app["title"] else False
        if on != _hdr["on"]:
            print(("HDR: " if on else "SDR: ") + (_app["title"] or "-"), flush=True)
        _hdr["on"] = on
        time.sleep(3)


# --- director: hold the lamps only while a screen is actually feeding HyperHDR -------------
# Without this, HyperHDR keeps its Hue Entertainment hold when the TV and PC are off and shows
# black: lamps stuck dark, and Siri scenes / the Hue app cannot take them back. So: no source
# for IDLE_RELEASE s -> switch HyperHDR's output off (it hands the lamps back as they were);
# a source appears again -> switch it back on. Only undoes its own pauses: an "off" set by the
# owner ("Stop syncing", a lighting routine) is left alone. State survives restarts.
IDLE_RELEASE = 10
WANT_FILE = "/var/lib/tv-mood/sync-wanted"   # exists = the owner asked for the sync (survives restarts)


def sync_wanted():
    return os.path.exists(WANT_FILE)


def set_wanted(v):
    try:
        if v: open(WANT_FILE, "w").close()
        elif os.path.exists(WANT_FILE): os.remove(WANT_FILE)
    except OSError: pass


def hyperhdr_leds(state):
    # HyperHDR output on/off (its LEDDEVICE component). Rare calls: one short connection each.
    try:
        with socket.create_connection(HYPERHDR, timeout=5) as c:
            f = c.makefile("rb")
            c.sendall((json.dumps({"command": "componentstate", "componentstate":
                                   {"component": "LEDDEVICE", "state": bool(state)}}) + "\n").encode())
            return bool(json.loads(f.readline()).get("success"))
    except Exception:
        return False


def director():
    idle_since = None
    # ONE connection, kept open: HyperHDR leaks ~1 KB for every connection it accepts, and opening
    # one per second grew it to 2.6 GB in two days and starved the Pi (2026-10-20, measured).
    c = f = None
    def rpc(o):
        c.sendall((json.dumps(o) + "\n").encode()); return json.loads(f.readline())
    while True:
        time.sleep(1)
        try:
            if c is None:
                c = socket.create_connection(HYPERHDR, timeout=5); f = c.makefile("rb")
            info = rpc({"command": "serverinfo"})["info"]
            fed = any(p.get("active") and p["priority"] < 250 for p in info["priorities"])
            led_on = next(x["enabled"] for x in info["components"] if x["name"] == "LEDDEVICE")
            if fed:
                idle_since = None
                if sync_wanted() and not led_on:
                    rpc({"command": "componentstate", "componentstate": {"component": "LEDDEVICE", "state": True}})
                    print("screen playing again: lamps taken back", flush=True)
                elif led_on and not sync_wanted():
                    # a source this script does not gate (the PC's forwarder) found the output on;
                    # the sync runs only when the owner asked (2026-11-05: it was on, unasked)
                    rpc({"command": "componentstate", "componentstate": {"component": "LEDDEVICE", "state": False}})
                    print("a screen is feeding but the sync was not asked for: lamps left alone", flush=True)
            else:
                idle_since = idle_since or time.time()
                if led_on and time.time() - idle_since > IDLE_RELEASE:
                    rpc({"command": "componentstate", "componentstate": {"component": "LEDDEVICE", "state": False}})
                    print("no screen playing: lamps handed back", flush=True)
        except Exception as e:
            try: c.close()
            except Exception: pass
            c = f = None
            time.sleep(4)


# --- the mood loop -------------------------------------------------------------------------
def main():
    # (The one-time 2026-10-21 migration that read "output on" as "sync wanted" whenever the
    # wish file was missing is gone: a missing file also means "not wanted", so any restart
    # while the output was on turned the sync wish on. Removed 2026-11-05.)
    threading.Thread(target=server, daemon=True).start()
    threading.Thread(target=director, daemon=True).start()
    threading.Thread(target=mode_server, daemon=True).start()
    threading.Thread(target=hdr_watch, daemon=True).start()
    shown = None; hh = None; f = None; logged = 0.0; sent_no = -1; sent_at = 0.0; last_t = None; wema = None; cut_until = 0.0
    run_from = None                               # when TV frames started flowing, frame_no then
    while True:
        time.sleep(1 / FPS)
        # One line when the TV starts and stops sending: the journal then shows HyperTizen came
        # back by itself after the TV was off (it has no other trace; backlog 0a, 2026-10-31).
        if time.time() - last_frame > 3:          # TV off / app stopped: let HyperHDR time out
            if run_from:
                print("TV frames stopped after %d min (%d frames)"
                      % ((last_frame - run_from[0]) / 60, frame_no - run_from[1]), flush=True)
                run_from = None
            shown = None; continue
        if not run_from:
            run_from = (time.time(), frame_no)
            print("TV frames started from", peer, flush=True)
        if not sync_wanted():                     # the owner did not ask for the sync: send nothing
            shown = None; continue
        if frame_no == sent_no and time.time() - sent_at < 1: continue   # nothing new from the TV
        z = robust_zones()
        if not z: continue
        sent_no, sent_at = frame_no, time.time()
        lin = {k: to_linear(c) for k, c in z.items()}
        whole, whole_lvl = region(list(lin.values()))
        target = []
        for zs in LAMPS:
            own, lvl = region([lin[k] for k in zs])
            mix = [(1 - GLOBAL) * o + GLOBAL * w for o, w in zip(own, whole)]
            target.append(lamp_colour(mix, (1 - GLOBAL) * lvl + GLOBAL * whole_lvl))
        glow = glow_active()
        if glow: target = glow_targets(lin)
        if os.environ.get("TV_MOOD_DEBUG") and time.time() - logged > 2:
            logged = time.time()
            print("hdr", hdr_active(), "zones", z, "lamps", [tuple(int(x) for x in t) for t in target], flush=True)
        # smoothing decided by the WHOLE picture, which is stable: each lamp's own area is read through
        # a few tiny 16x16-pixel spots that move every frame, so its value wobbles even in a still
        # scene. Calm picture: lamps ease over ~0.9 s (no flicker). The whole picture jumps (a cut, a
        # flash) or one lamp's area changes hugely: lamps land in ~0.12 s (no lag).
        now = time.time(); dt = min(0.3, now - (last_t or now)); last_t = now
        wcol = lamp_colour(whole, whole_lvl)
        if wema is None: wema = wcol
        if sum((wcol[i] - wema[i]) ** 2 for i in range(3)) ** 0.5 > CUT_GLOBAL: cut_until = now + 0.5; wema = wcol
        else: wema = tuple(wema[i] + (1 - math.exp(-dt / 1.0)) * (wcol[i] - wema[i]) for i in range(3))
        # colour and brightness move separately. Colour follows in ~0.45 s (faster only on a hard cut).
        # Brightness ALWAYS glides: ~1.2 s ease and never faster than LEVEL_RATE per second, so a flash
        # or a cut to black fades instead of jumping (owner, 2026-10-19: "something in between").
        if shown is None: shown = [(max(t) / 255, tuple(c / max(max(t), 1e-6) for c in t)) for t in target]
        ac = 1 - math.exp(-dt / (TAU_CUT if now < cut_until else TAU_CALM)) if dt > 0 else 1
        al = 1 - math.exp(-dt / (TAU_GLOW if glow else TAU_LEVEL)) if dt > 0 else 1
        rate = GLOW_RATE if glow else LEVEL_RATE
        nxt = []
        for (lv, col), t in zip(shown, target):
            tl = max(t) / 255
            tc = tuple(c / max(t) for c in t) if max(t) > 0 else col
            col = tuple(col[i] + ac * (tc[i] - col[i]) for i in range(3))
            step = max(-rate * dt, min(rate * dt, al * (tl - lv)))
            nxt.append((lv + step, col))
        shown = nxt
        out = [tuple(c / max(max(col), 1e-6) * lv * 255 for c in col) for lv, col in shown]
        row = bytes(max(0, min(255, int(round(c)))) for px in out for c in px)
        raw = row * 4                             # HyperHDR ignores 1-pixel-tall images
        msg = {"command": "image", "imagewidth": len(LAMPS), "imageheight": 4, "format": "rgb",
               "imagedata": base64.b64encode(raw).decode(), "priority": PRIORITY,
               "origin": "TV mood", "duration": 3000}
        try:
            if hh is None:
                hh = socket.create_connection(HYPERHDR, timeout=5); f = hh.makefile("rb")
            hh.sendall((json.dumps(msg) + "\n").encode()); f.readline()
        except Exception:
            hh = None; time.sleep(2)


if __name__ == "__main__":
    main()
